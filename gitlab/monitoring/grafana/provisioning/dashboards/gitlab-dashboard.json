{
  "title": "GitLab Merge Request Analytics",
  "uid": "gitlab-mr-analytics",
  "timezone": "browser",
  "refresh": "5s",
  "editable": true,
  "time": {
    "from": "now-7d",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "title": "In Review",
      "type": "stat",
      "gridPos": {"x": 0, "y": 0, "w": 8, "h": 6},
      "targets": [{
        "expr": "count(gitlab_mr_time_in_review_hours{project=~\"$repository\",branch=~\"$branch\"}) or vector(0)",
        "refId": "A",
        "legendFormat": ""
      }],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "blue", "value": null},
              {"color": "yellow", "value": 3},
              {"color": "orange", "value": 5}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "text": {
          "titleSize": 18,
          "valueSize": 50
        }
      }
    },
    {
      "id": 2,
      "title": "Rework",
      "type": "stat",
      "gridPos": {"x": 8, "y": 0, "w": 8, "h": 6},
      "targets": [{
        "expr": "count(gitlab_mr_time_in_rework_hours{project=~\"$repository\",branch=~\"$branch\"}) or vector(0)",
        "refId": "A",
        "legendFormat": ""
      }],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "red", "value": null},
              {"color": "orange", "value": 3},
              {"color": "yellow", "value": 5}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "text": {
          "titleSize": 18,
          "valueSize": 50
        }
      }
    },
    {
      "id": 3,
      "title": "Rework Done",
      "type": "stat",
      "gridPos": {"x": 16, "y": 0, "w": 8, "h": 6},
      "targets": [{
        "expr": "count(gitlab_mr_time_to_complete_hours{project=~\"$repository\",branch=~\"$branch\"}) or vector(0)",
        "refId": "A",
        "legendFormat": ""
      }],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "gray", "value": null},
              {"color": "green", "value": 1}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "text": {
          "titleSize": 18,
          "valueSize": 50
        }
      }
    },
    {
      "id": 4,
      "title": "Review Time (Hours)",
      "type": "stat",
      "gridPos": {"x": 0, "y": 6, "w": 8, "h": 6},
      "targets": [{
        "expr": "gitlab_mr_time_in_review_hours{project=~\"$repository\",branch=~\"$branch\"}",
        "refId": "A",
        "legendFormat": "{{branch}}"
      }],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "h",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 24},
              {"color": "orange", "value": 48},
              {"color": "red", "value": 72}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "text": {
          "titleSize": 16,
          "valueSize": 40
        }
      }
    },
    {
      "id": 5,
      "title": "Rework Time (Hours)",
      "type": "stat",
      "gridPos": {"x": 8, "y": 6, "w": 8, "h": 6},
      "targets": [{
        "expr": "gitlab_mr_time_in_rework_hours{project=~\"$repository\",branch=~\"$branch\"}",
        "refId": "A",
        "legendFormat": "{{branch}}"
      }],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "h",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 48},
              {"color": "orange", "value": 96},
              {"color": "red", "value": 168}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "text": {
          "titleSize": 16,
          "valueSize": 40
        }
      }
    },
    {
      "id": 6,
      "title": "Total Completion Time (Hours)",
      "type": "stat",
      "gridPos": {"x": 16, "y": 6, "w": 8, "h": 6},
      "targets": [{
        "expr": "gitlab_mr_time_to_complete_hours{project=~\"$repository\",branch=~\"$branch\"}",
        "refId": "A",
        "legendFormat": "{{branch}}"
      }],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "decimals": 2,
          "unit": "h",
          "color": {"mode": "thresholds"},
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {"color": "green", "value": null},
              {"color": "yellow", "value": 72},
              {"color": "orange", "value": 168},
              {"color": "red", "value": 336}
            ]
          }
        }
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "justifyMode": "center",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "text": {
          "titleSize": 16,
          "valueSize": 40
        }
      }
    },
    {
      "id": 7,
      "title": "Merge Request Details",
      "type": "table",
      "gridPos": {"x": 0, "y": 12, "w": 24, "h": 10},
      "targets": [{
        "expr": "gitlab_mr_info{project=~\"$repository\",branch=~\"$branch\"}",
        "format": "table",
        "instant": true,
        "refId": "A"
      }],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value": true,
              "__name__": true,
              "instance": true,
              "job": true
            },
            "renameByName": {
              "project": "Repository",
              "branch": "Branch",
              "target": "Target Branch",
              "title": "MR Title"
            }
          }
        }
      ],
      "datasource": "Prometheus",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "displayMode": "auto"
          }
        }
      }
    }
  ],
  "templating": {
    "list": [
      {
        "name": "repository",
        "label": "Repository",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(gitlab_merge_requests_total, project)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "branch",
        "label": "Branch",
        "type": "query",
        "datasource": "Prometheus",
        "query": "label_values(gitlab_mr_info{project=~\"$repository\"}, branch)",
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 1,
        "sort": 1,
        "current": {
          "selected": true,
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  }
}
